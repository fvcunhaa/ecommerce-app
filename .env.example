# Ambiente da aplicação
FLASK_ENV=development

# PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecommerce:ecommerce123@postgres:5432/ecommerce

# ObsStore Simulator
TARGET_REVENUE_DAILY=100000
VISITS_PER_MINUTE=8
PAYMENT_FAILURE_RATE=0.03
CART_RATE=0.42
BASE_CONVERSION_RATE=0.012

# OpenTelemetry
# O Collector roda no mesmo host em compose separado e compartilha a rede
# externa Docker "observability_net".
OTEL_SERVICE_NAME=obsstore-api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=obsstore,deployment.environment=lab
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_BSP_SCHEDULE_DELAY=1000

# Serviços internos
SERVICE_TIMEOUT_SECONDS=5
PAYMENT_GATEWAY_MIN_MS=80
PAYMENT_GATEWAY_MAX_MS=260
SHIPPING_MIN_MS=40
SHIPPING_MAX_MS=140
