# Ambiente da aplicação
FLASK_ENV=development

# PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL usada pela aplicação Flask
DATABASE_URL=postgresql://ecommerce:ecommerce123@postgres:5432/ecommerce

# ObsStore Simulator
# Meta financeira aproximada que o simulador tenta acompanhar ao longo do dia.
TARGET_REVENUE_DAILY=100000

# Volume de visitantes virtuais. 8/min ~= 11.520 sessões/dia.
VISITS_PER_MINUTE=8

# Probabilidade de falha proposital durante o pagamento.
PAYMENT_FAILURE_RATE=0.03

# Percentual aproximado de visitantes que inicia uma jornada de carrinho.
CART_RATE=0.42

# Conversão mínima. O simulador aumenta dinamicamente esta taxa quando
# o faturamento fica abaixo da curva esperada para atingir a meta diária.
BASE_CONVERSION_RATE=0.012

# OpenTelemetry
# A instrumentação é vendor-neutral. Enquanto o receiver do Zabbix 8 não estiver
# configurado, os exporters ficam desabilitados para evitar envio para um destino incorreto.
OTEL_SERVICE_NAME=obsstore-api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=obsstore,deployment.environment=lab
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Quando o receiver OTLP estiver definido:
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://SEU-RECEIVER-OTLP:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
